# MySQL connection URL for Prisma (required)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://patch_user:patch_password@localhost:3306/patchplatform"

# Individual MySQL connection variables (used by docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=patch_user
MYSQL_PASSWORD=patch_password
MYSQL_DATABASE=patchplatform

# Application
PORT=3000
NODE_ENV=development
